# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# Perfil de Ollama según tu hardware: cpu | nvidia | amd (ROCm) | vulkan
COMPOSE_PROFILES=nvidia
# Puerto público del servicio (el único expuesto).
API_PORT=8000
# Nivel de log de la API y el worker (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL + pgvector
# ---------------------------------------------------------------------------
POSTGRES_USER=support
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=support
# Dentro de Docker, compose construye DATABASE_URL a partir de las variables de
# arriba. Solo hace falta definirla para ejecutar el servicio fuera de Docker.
# DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support

# ---------------------------------------------------------------------------
# Proveedor de LLM (cualquier API compatible con OpenAI; Ollama por defecto)
# ---------------------------------------------------------------------------
# Ollama vive en la red interna de Docker con el alias "ollama".
LLM_BASE_URL=http://ollama:11434/v1
# Opcional: solo si el proveedor exige "Authorization: Bearer". Ollama no la necesita.
LLM_API_KEY=
# Modelo de chat. Alternativa: gemma4:12b
LLM_CHAT_MODEL=qwen3:8b
# Modelo de embeddings. Cambiarlo obliga a reindexar la documentación.
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.3
# Ventana de contexto en tokens. Se pasa a Ollama (OLLAMA_CONTEXT_LENGTH) y el
# servicio la usa para presupuestar el prompt.
LLM_NUM_CTX=8192
# Timeout de cada petición al LLM, en segundos.
LLM_TIMEOUT=60
# Opcional: "none" desactiva el modo de razonamiento de modelos como qwen3
# (menos latencia). Déjalo vacío para no enviar el parámetro.
LLM_REASONING_EFFORT=none
# Tiempo que Ollama mantiene los modelos cargados en memoria.
OLLAMA_KEEP_ALIVE=24h

# ---------------------------------------------------------------------------
# Embeddings y RAG
# ---------------------------------------------------------------------------
# Dimensión del modelo de embeddings (nomic-embed-text = 768). Se fija en la
# migración: cambiarla exige una migración nueva y reindexar.
EMBEDDING_DIMENSIONS=768
# Prefijos que recomienda nomic-embed-text para documentos y consultas. Déjalos
# vacíos si usas un modelo que no los necesita.
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "
# Tamaño objetivo de cada chunk y solape entre chunks consecutivos (en tokens).
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
# Fragmentos que se recuperan por pregunta y similitud de coseno mínima (0–1).
RAG_TOP_K=4
RAG_MIN_SCORE=0.5

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Segundos entre sondeos cuando no hay trabajo pendiente.
WORKER_POLL_INTERVAL=2

# ---------------------------------------------------------------------------
# Conversaciones
# ---------------------------------------------------------------------------
# Fichero del system prompt (se relee al cambiar, sin reiniciar).
SYSTEM_PROMPT_PATH=prompts/system.md
# Historial literal que se envía al modelo: últimos N mensajes que quepan en el
# presupuesto de tokens. Lo anterior se condensa en un resumen.
HISTORY_MAX_MESSAGES=10
HISTORY_MAX_TOKENS=2000

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
# URL pública del servicio; se usa para construir los enlaces de los webhooks.
PUBLIC_BASE_URL=https://soporte.midominio.com
# Timeout de cada envío, número máximo de intentos y espera base del backoff
# (30 s, 60 s, 120 s... hasta un máximo de 1 h entre intentos).
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_SECONDS=30

# ---------------------------------------------------------------------------
# Widget: JWT, CORS, rate limit y tiempo real
# ---------------------------------------------------------------------------
# Dentro de Docker compose fija REDIS_URL=redis://redis:6379/0. Solo hace falta
# fuera de Docker.
# REDIS_URL=redis://localhost:6379/0
# Vida máxima aceptada para el JWT del usuario (exp - iat), en segundos, y
# margen de reloj tolerado entre tu app y el servicio.
JWT_MAX_TTL_SECONDS=900
JWT_LEEWAY_SECONDS=30
# Peticiones por minuto a la API del widget, por usuario y por IP.
RATE_LIMIT_USER_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=120
# Segundos que se cachean los orígenes permitidos de las apps (CORS).
CORS_CACHE_SECONDS=30
# Frecuencia de sondeo de mensajes del agente y latido del stream SSE.
WIDGET_POLL_INTERVAL=2
SSE_HEARTBEAT_SECONDS=15
# IPs del proxy inverso en las que se confía para X-Forwarded-For (las lee uvicorn).
# Pon la de tu proxy (o la red de Docker) para que el rate limit vea la IP real.
FORWARDED_ALLOW_IPS=127.0.0.1
